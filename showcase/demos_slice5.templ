package showcase

import "github.com/vapulab/malphas/components"

templ demoPopover() {
	<div class="flex flex-col gap-4">
		<p class="text-sm text-muted">
			Focus moves into the panel when it opens. Escape closes it and returns focus to the button; Tab
			goes through the content and on to the page, closing the panel.
		</p>
		<div class="flex flex-wrap gap-4">
			@components.Popover(components.PopoverProps{ID: "pop-filtros", Label: "Filters", Title: "Search filters"}) {
				<div class="flex flex-col gap-3">
					@components.Input(components.InputProps{ID: "pop-autor", Name: "autor", Label: "Author"})
					@components.Checkbox(components.CheckboxProps{ID: "pop-recentes", Name: "recentes", Label: "Last 30 days only"})
				</div>
			}
			<div x-data>
				@components.Button(components.ButtonProps{Variant: "secondary", Attrs: templ.Attributes{
					"id": "abrir-modal-popover", "x-on:click": "$dispatch('open-modal', 'modal-popover')",
				}}) {
					Popover inside a modal
				}
			</div>
		</div>
		@components.Modal(components.ModalProps{ID: "modal-popover", Title: "Edit protocol"}) {
			<p class="mb-4 text-sm text-muted">Escape with the popover open closes only the popover.</p>
			@components.Popover(components.PopoverProps{ID: "pop-no-modal", Label: "Help"}) {
				<p class="text-sm text-fg">The protocol is saved after each completed step.</p>
			}
		}
	</div>
}

templ demoHoverCard() {
	<p class="text-sm text-fg">
		// templ trims the whitespace around a component call; the spaces in
		// the sentence have to be explicit.
		Protocol reviewed by{ " " }
		@components.HoverCard(components.HoverCardProps{ID: "hc-lincoln", Label: "@lincoln", Href: "/components/hover-card"}) {
			<span class="flex flex-col gap-1">
				<span class="text-sm font-semibold text-fg">Lincoln Santos</span>
				<span class="text-sm text-muted">Researcher · 42 published protocols</span>
			</span>
		}
		{ " " }yesterday at 6 pm.
	</p>
}

templ demoAlertDialog() {
	<div class="flex flex-col gap-4">
		<p class="text-sm text-muted">
			Focus starts on Cancel. Clicking outside does not close it: only the two answers or Escape do.
		</p>
		<div class="flex items-center gap-4" x-data>
			@components.Button(components.ButtonProps{Variant: "danger", Attrs: templ.Attributes{
				"id": "abrir-ad", "x-on:click": "$dispatch('open-alert-dialog', 'ad-excluir')",
			}}) {
				Delete protocol
			}
			<span id="ad-resultado" class="text-sm text-muted" aria-live="polite"></span>
		</div>
		@components.AlertDialog(components.AlertDialogProps{
			ID:           "ad-excluir",
			Title:        "Delete the protocol?",
			Description:  "Its steps and results go with it. This cannot be undone.",
			ConfirmLabel: "Delete",
			ConfirmAttrs: templ.Attributes{"x-on:click": "document.getElementById('ad-resultado').textContent = 'deleted'"},
		})
		<div x-data>
			@components.Button(components.ButtonProps{Variant: "secondary", Attrs: templ.Attributes{
				"id": "abrir-md-editar", "x-on:click": "$dispatch('open-modal', 'md-editar')",
			}}) {
				Confirmation over a modal
			}
		</div>
		@components.Modal(components.ModalProps{ID: "md-editar", Title: "Edit protocol"}) {
			<p class="mb-4 text-sm text-muted">Escape closes only the confirmation; the form stays open.</p>
			<div x-data>
				@components.Button(components.ButtonProps{Variant: "danger", Attrs: templ.Attributes{
					"id": "abrir-ad-descartar", "x-on:click": "$dispatch('open-alert-dialog', 'ad-descartar')",
				}}) {
					Discard changes
				}
			</div>
		}
		@components.AlertDialog(components.AlertDialogProps{
			ID: "ad-descartar", Title: "Discard your changes?", Description: "What you edited in this protocol will be lost.",
			ConfirmLabel: "Discard",
		})
	</div>
}

templ demoContextMenu() {
	<div class="flex flex-col gap-3">
		@components.ContextMenu(components.ContextMenuProps{
			ID: "cm-arquivo", Label: "File actions",
			Entries: []components.MenuEntry{
				{Label: "Rename", OnClick: "document.getElementById('cm-resultado').textContent = 'rename'"},
				{Label: "Duplicate", OnClick: "document.getElementById('cm-resultado').textContent = 'duplicate'"},
				components.MenuDivider(),
				{Label: "Delete", OnClick: "document.getElementById('cm-resultado').textContent = 'delete'"},
			},
		}) {
			<div class="flex h-32 w-full items-center justify-center rounded border border-dashed border-border text-sm text-muted">
				quarterly-report.pdf — right-click here
			</div>
		}
		<p class="text-sm text-muted">Last action: <span id="cm-resultado" aria-live="polite">none</span></p>
	</div>
}

func mbSet(what string) string {
	return "document.getElementById('mb-resultado').textContent = '" + what + "'"
}

templ demoMenubar() {
	<div class="flex flex-col gap-3">
		@components.Menubar(components.MenubarProps{
			Label: "Protocol editor",
			Menus: []components.MenubarMenu{
				{Label: "File", Entries: []components.MenuEntry{
					{Label: "New protocol", OnClick: mbSet("new")},
					{Label: "Open…", OnClick: mbSet("open")},
					components.MenuDivider(),
					{Label: "Export PDF", OnClick: mbSet("export")},
				}},
				{Label: "Edit", Entries: []components.MenuEntry{
					{Label: "Undo", OnClick: mbSet("undo")},
					{Label: "Redo", OnClick: mbSet("redo"), Disabled: true},
					{Label: "Duplicate step", OnClick: mbSet("duplicate")},
				}},
				{Label: "View", Entries: []components.MenuEntry{
					{Label: "Focus mode", OnClick: mbSet("focus")},
					{Label: "Show comments", OnClick: mbSet("comments")},
				}},
			},
		})
		<p class="text-sm text-muted">Last action: <span id="mb-resultado" aria-live="polite">none</span></p>
	</div>
}

func cmdSet(what string) string {
	return "document.getElementById('cmd-resultado').textContent = '" + what + "'"
}

templ demoCommand() {
	<div class="flex flex-col gap-3">
		<div class="flex flex-wrap items-center gap-3" x-data>
			@components.Button(components.ButtonProps{Variant: "secondary", Attrs: templ.Attributes{
				"id": "abrir-cmd", "x-on:click": "$dispatch('open-command', 'cmd-paleta')",
			}}) {
				Open palette
			}
			<span class="text-sm text-muted">
				or
				@components.Kbd(components.KbdProps{}) {
					Ctrl
				}
				+
				@components.Kbd(components.KbdProps{}) {
					K
				}
			</span>
		</div>
		<p class="text-sm text-muted">Last command: <span id="cmd-resultado" aria-live="polite">none</span></p>
		@components.Command(components.CommandProps{
			ID: "cmd-paleta", Placeholder: "Search for a command or page…", Hotkey: true,
			Groups: []components.CommandGroup{
				{Heading: "Actions", Items: []components.CommandItem{
					{Label: "Toggle theme", OnClick: cmdSet("toggle theme"), Shortcut: "Ctrl T"},
					{Label: "System theme", OnClick: cmdSet("system theme")},
					{Label: "New protocol", OnClick: cmdSet("new protocol"), Shortcut: "Ctrl N"},
					{Label: "Sign out", OnClick: cmdSet("sign out"), Disabled: true},
				}},
				{Heading: "Pages", Items: []components.CommandItem{
					{Label: "All components", Href: "/components"},
					{Label: "Combobox", Href: "/components/combobox"},
				}},
			},
		})
	</div>
}

templ demoDrawerBottom() {
	<div x-data>
		@components.Button(components.ButtonProps{Variant: "secondary", Attrs: templ.Attributes{
			"id": "abrir-drawer-bottom", "x-on:click": "$dispatch('open-drawer', 'demo-drawer-bottom')",
		}}) {
			Open from the bottom
		}
	</div>
	@components.Drawer(components.DrawerProps{ID: "demo-drawer-bottom", Title: "Share protocol", Side: "bottom"}) {
		<div class="flex flex-col gap-4">
			@components.Input(components.InputProps{ID: "db-email", Name: "email", Label: "Recipient email", Type: "email"})
			@components.Button(components.ButtonProps{Size: "sm"}) {
				Send invite
			}
		</div>
	}
}
