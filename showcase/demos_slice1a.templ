package showcase

import "github.com/vapulab/malphas/components"

templ demoAlertVariants() {
	<div class="flex flex-col gap-3">
		@components.Alert(components.AlertProps{Variant: "info"}) {
			<span>A new migration is available.</span>
		}
		@components.Alert(components.AlertProps{Variant: "success"}) {
			<span>Deploy finished successfully.</span>
		}
		@components.Alert(components.AlertProps{Variant: "warning"}) {
			<span>Your token expires in 3 days.</span>
		}
		@components.Alert(components.AlertProps{Variant: "error"}) {
			<span>Could not connect to the database.</span>
		}
	</div>
}

templ demoBadgeSolid() {
	<div class="flex flex-wrap items-center gap-2">
		@components.Badge(components.BadgeProps{}) {
			Neutral
		}
		@components.Badge(components.BadgeProps{Variant: "primary"}) {
			Primary
		}
		@components.Badge(components.BadgeProps{Variant: "success"}) {
			Active
		}
		@components.Badge(components.BadgeProps{Variant: "warning"}) {
			Pending
		}
		@components.Badge(components.BadgeProps{Variant: "danger"}) {
			Failed
		}
		@components.Badge(components.BadgeProps{Variant: "info"}) {
			Info
		}
	</div>
}

templ demoBadgeOutline() {
	<div class="flex flex-wrap items-center gap-2">
		@components.Badge(components.BadgeProps{Variant: "primary", Outline: true}) {
			Primary
		}
		@components.Badge(components.BadgeProps{Variant: "success", Outline: true}) {
			Active
		}
		@components.Badge(components.BadgeProps{Variant: "danger", Outline: true, Size: "sm"}) {
			Small
		}
	</div>
}

templ demoKbd() {
	<div class="flex flex-wrap items-center gap-2 text-sm text-muted">
		@components.Kbd(components.KbdProps{}) {
			Ctrl
		}
		<span>+</span>
		@components.Kbd(components.KbdProps{}) {
			K
		}
		<span class="ml-4">to search</span>
	</div>
}

templ demoLink() {
	<div class="flex flex-col items-start gap-2">
		@components.Link(components.LinkProps{Href: "/all"}) {
			Internal link
		}
		@components.Link(components.LinkProps{Href: "/", Variant: "muted"}) {
			Subtle
		}
		@components.Link(components.LinkProps{Href: "https://templ.guide", External: true, Underline: true}) {
			templ.guide (new tab)
		}
	</div>
}

templ demoDivider() {
	<div>
		<p class="text-muted">Above</p>
		@components.Divider(components.DividerProps{})
		<p class="text-muted">Below</p>
		@components.Divider(components.DividerProps{Label: "or"})
		<div class="flex h-12 items-center">
			<span class="text-muted">Left</span>
			@components.Divider(components.DividerProps{Vertical: true})
			<span class="text-muted">Right</span>
		</div>
	</div>
}

templ demoFooter() {
	@components.Footer(components.FooterProps{
		Note: "© 2026 Vapulab",
		Columns: []components.FooterColumn{
			{Title: "Product", Links: []components.FooterLink{
				{Label: "Components", Href: "/components"},
			}},
			{Title: "Code", Links: []components.FooterLink{
				{Label: "GitHub", Href: "https://github.com/vapulab/malphas", External: true},
			}},
		},
	}) {
		<span class="font-semibold text-fg">vapulab</span>
	}
}
