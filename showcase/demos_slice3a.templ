package showcase

import "github.com/vapulab/malphas/components"

// The trigger needs an x-data ancestor: Alpine only provides $dispatch inside
// a component tree.
templ demoDrawer() {
	<div class="flex flex-col gap-3">
		<p class="text-sm text-muted">
			Open it and try to Tab out: focus cycles inside. Escape closes it and returns
			focus to the button. While it is open, the page behind does not scroll.
		</p>
		<div x-data class="flex gap-3">
			@components.Button(components.ButtonProps{Attrs: templ.Attributes{"x-on:click": "$dispatch('open-drawer', 'demo-drawer-left')"}}) {
				Open on the left
			}
			@components.Button(components.ButtonProps{Variant: "secondary", Attrs: templ.Attributes{"x-on:click": "$dispatch('open-drawer', 'demo-drawer-right')"}}) {
				Open on the right
			}
		</div>
	</div>
	@components.Drawer(components.DrawerProps{ID: "demo-drawer-left", Title: "Navigation"}) {
		@components.Menu(components.MenuProps{Entries: []components.MenuEntry{
			{Label: "Home", Href: "/", Current: true},
			{Label: "Components", Href: "/"},
			components.MenuDivider(),
			{Label: "All", Href: "/all"},
		}})
	}
	@components.Drawer(components.DrawerProps{ID: "demo-drawer-right", Title: "Filters", Side: "right"}) {
		<div class="flex flex-col gap-4">
			@components.Checkbox(components.CheckboxProps{ID: "d-ativo", Name: "ativo", Label: "Active only"})
			@components.Checkbox(components.CheckboxProps{ID: "d-arq", Name: "arq", Label: "Include archived"})
			@components.Button(components.ButtonProps{Size: "sm"}) {
				Apply
			}
		</div>
	}
}

// The action entry dispatches an event; nothing listened to it, so clicking
// "Sign out" did nothing and the whole component looked broken. The wrapper now
// listens and shows the result.
templ demoMenu() {
	<div class="flex flex-col gap-4" x-data="{ saiu: false }" x-on:demo-logout="saiu = true">
		<p class="text-sm text-muted">
			Menu is navigation, not a widget: the links navigate and Tab moves through them,
			no arrows. The current item carries <code class="text-fg">aria-current</code>,
			the divider takes no focus, and the last entry is a button that fires an
			event instead of navigating.
		</p>
		<div class="max-w-xs rounded border border-border bg-surface p-2">
			@components.Menu(components.MenuProps{
				Landmark: true,
				Label:    "Example",
				Entries: []components.MenuEntry{
					{Label: "Home", Href: "/", Current: true},
					{Label: "Components", Href: "/"},
					{Label: "All", Href: "/all"},
					components.MenuDivider(),
					{Label: "Sign out", OnClick: "$dispatch('demo-logout')"},
				},
			})
		</div>
		<div x-show="saiu" style="display:none">
			@components.Alert(components.AlertProps{Variant: "success"}) {
				<span>Event <code>demo-logout</code> received — the action entry works.</span>
			}
		</div>
	</div>
}

templ demoNavbar() {
	@components.Navbar(components.NavbarProps{
		Brand:    "Vapulab",
		DrawerID: "demo-navbar-drawer",
		Entries: []components.MenuEntry{
			{Label: "Components", Href: "/", Current: true},
			{Label: "All", Href: "/all"},
		},
	}) {
		@components.Badge(components.BadgeProps{Variant: "success", Size: "sm"}) {
			online
		}
	}
	@components.Drawer(components.DrawerProps{ID: "demo-navbar-drawer", Title: "Menu"}) {
		@components.Menu(components.MenuProps{Entries: []components.MenuEntry{
			{Label: "Components", Href: "/", Current: true},
			{Label: "All", Href: "/all"},
		}})
	}
	<p class="mt-3 text-sm text-muted">
		The menu button only appears on narrow screens — shrink the window to see it.
		It exists only because a DrawerID was given.
	</p>
}
