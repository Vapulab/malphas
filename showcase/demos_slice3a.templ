package showcase

import "github.com/vapulab/malphas/components"

// The trigger needs an x-data ancestor: Alpine only provides $dispatch inside
// a component tree.
templ demoDrawer() {
	<div class="flex flex-col gap-3">
		<p class="text-sm text-muted">
			Abra e tente sair com Tab: o foco circula dentro. Escape fecha e devolve
			o foco ao botão. Enquanto aberto, a página atrás não rola.
		</p>
		<div x-data class="flex gap-3">
			@components.Button(components.ButtonProps{Attrs: templ.Attributes{"x-on:click": "$dispatch('open-drawer', 'demo-drawer-left')"}}) {
				Abrir à esquerda
			}
			@components.Button(components.ButtonProps{Variant: "secondary", Attrs: templ.Attributes{"x-on:click": "$dispatch('open-drawer', 'demo-drawer-right')"}}) {
				Abrir à direita
			}
		</div>
	</div>
	@components.Drawer(components.DrawerProps{ID: "demo-drawer-left", Title: "Navegação"}) {
		@components.Menu(components.MenuProps{Entries: []components.MenuEntry{
			{Label: "Início", Href: "/", Current: true},
			{Label: "Componentes", Href: "/"},
			components.MenuDivider(),
			{Label: "Todos", Href: "/todos"},
		}})
	}
	@components.Drawer(components.DrawerProps{ID: "demo-drawer-right", Title: "Filtros", Side: "right"}) {
		<div class="flex flex-col gap-4">
			@components.Checkbox(components.CheckboxProps{ID: "d-ativo", Name: "ativo", Label: "Somente ativos"})
			@components.Checkbox(components.CheckboxProps{ID: "d-arq", Name: "arq", Label: "Incluir arquivados"})
			@components.Button(components.ButtonProps{Size: "sm"}) {
				Aplicar
			}
		</div>
	}
}

// The action entry dispatches an event; nothing listened to it, so clicking
// "Sair" did nothing and the whole component looked broken. The wrapper now
// listens and shows the result.
templ demoMenu() {
	<div class="flex flex-col gap-4" x-data="{ saiu: false }" x-on:demo-logout="saiu = true">
		<p class="text-sm text-muted">
			O Menu é navegação, não widget: os links navegam e o Tab passa por eles,
			sem setas. O item atual leva <code class="text-fg">aria-current</code>,
			o divisor não recebe foco, e a última entrada é um botão que dispara um
			evento em vez de navegar.
		</p>
		<div class="max-w-xs rounded border border-border bg-surface p-2">
			@components.Menu(components.MenuProps{
				Landmark: true,
				Label:    "Exemplo",
				Entries: []components.MenuEntry{
					{Label: "Início", Href: "/", Current: true},
					{Label: "Componentes", Href: "/"},
					{Label: "Todos", Href: "/todos"},
					components.MenuDivider(),
					{Label: "Sair", OnClick: "$dispatch('demo-logout')"},
				},
			})
		</div>
		<div x-show="saiu" style="display:none">
			@components.Alert(components.AlertProps{Variant: "success"}) {
				<span>Evento <code>demo-logout</code> recebido — a entrada de ação funciona.</span>
			}
		</div>
	</div>
}

templ demoNavbar() {
	@components.Navbar(components.NavbarProps{
		Brand:    "Vapulab",
		DrawerID: "demo-navbar-drawer",
		Entries: []components.MenuEntry{
			{Label: "Componentes", Href: "/", Current: true},
			{Label: "Todos", Href: "/todos"},
		},
	}) {
		@components.Badge(components.BadgeProps{Variant: "success", Size: "sm"}) {
			online
		}
	}
	@components.Drawer(components.DrawerProps{ID: "demo-navbar-drawer", Title: "Menu"}) {
		@components.Menu(components.MenuProps{Entries: []components.MenuEntry{
			{Label: "Componentes", Href: "/", Current: true},
			{Label: "Todos", Href: "/todos"},
		}})
	}
	<p class="mt-3 text-sm text-muted">
		O botão de menu só aparece em telas estreitas — reduza a janela para vê-lo.
		Ele existe apenas porque um DrawerID foi informado.
	</p>
}
