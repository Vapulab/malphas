package showcase

import "github.com/vapulab/malphas/components"

templ demoBreadcrumbs() {
	@components.Breadcrumbs(components.BreadcrumbsProps{Items: []components.BreadcrumbItem{
		{Label: "Home", Href: "/"},
		{Label: "Components", Href: "/"},
		{Label: "Breadcrumbs"},
	}})
}

templ demoSteps() {
	@components.Steps(components.StepsProps{Items: []components.Step{
		{Label: "Account", State: "done"},
		{Label: "Payment", State: "current"},
		{Label: "Confirmation"},
	}})
}

templ demoStepsVertical() {
	@components.Steps(components.StepsProps{Vertical: true, Items: []components.Step{
		{Label: "Repository cloned", State: "done"},
		{Label: "Migrations applied", State: "done"},
		{Label: "Build", State: "current"},
		{Label: "Deploy"},
	}})
}

templ demoTimeline() {
	@components.Timeline(components.TimelineProps{Items: []components.TimelineItem{
		{Time: "09:00", Title: "Deploy started", Description: "build #481, branch main"},
		{Time: "09:02", Title: "Migrations applied", Variant: "muted"},
		{Time: "09:04", Title: "Deploy finished", Description: "zero downtime", Variant: "success"},
	}})
}

templ demoIndicator() {
	<div class="flex flex-wrap items-center gap-8">
		@components.Indicator(components.IndicatorProps{Label: "9"}) {
			@components.Button(components.ButtonProps{Variant: "secondary"}) {
				Inbox
			}
		}
		@components.Indicator(components.IndicatorProps{Label: "new", Variant: "primary", Position: "top-left"}) {
			@components.Avatar(components.AvatarProps{Initials: "LS", Size: "lg"})
		}
	</div>
}

templ demoJoin() {
	<div class="flex flex-col items-start gap-6">
		@components.Join(components.JoinProps{}) {
			@components.Button(components.ButtonProps{Variant: "secondary"}) {
				Day
			}
			@components.Button(components.ButtonProps{Variant: "secondary"}) {
				Week
			}
			@components.Button(components.ButtonProps{Variant: "secondary"}) {
				Month
			}
		}
		@components.Join(components.JoinProps{Vertical: true}) {
			@components.Button(components.ButtonProps{Variant: "secondary"}) {
				Top
			}
			@components.Button(components.ButtonProps{Variant: "secondary"}) {
				Middle
			}
			@components.Button(components.ButtonProps{Variant: "secondary"}) {
				Bottom
			}
		}
	</div>
}
