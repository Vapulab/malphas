package showcase

import "github.com/vapulab/malphas/components"

templ demoBreadcrumbs() {
	@components.Breadcrumbs(components.BreadcrumbsProps{Items: []components.BreadcrumbItem{
		{Label: "Início", Href: "/"},
		{Label: "Componentes", Href: "/"},
		{Label: "Breadcrumbs"},
	}})
}

templ demoSteps() {
	@components.Steps(components.StepsProps{Items: []components.Step{
		{Label: "Conta", State: "done"},
		{Label: "Pagamento", State: "current"},
		{Label: "Confirmação"},
	}})
}

templ demoStepsVertical() {
	@components.Steps(components.StepsProps{Vertical: true, Items: []components.Step{
		{Label: "Repositório clonado", State: "done"},
		{Label: "Migrations aplicadas", State: "done"},
		{Label: "Build", State: "current"},
		{Label: "Deploy"},
	}})
}

templ demoTimeline() {
	@components.Timeline(components.TimelineProps{Items: []components.TimelineItem{
		{Time: "09:00", Title: "Deploy iniciado", Description: "build #481, branch main"},
		{Time: "09:02", Title: "Migrations aplicadas", Variant: "muted"},
		{Time: "09:04", Title: "Deploy concluído", Description: "sem downtime", Variant: "success"},
	}})
}

templ demoIndicator() {
	<div class="flex flex-wrap items-center gap-8">
		@components.Indicator(components.IndicatorProps{Label: "9"}) {
			@components.Button(components.ButtonProps{Variant: "secondary"}) {
				Caixa de entrada
			}
		}
		@components.Indicator(components.IndicatorProps{Label: "novo", Variant: "primary", Position: "top-left"}) {
			@components.Avatar(components.AvatarProps{Initials: "LS", Size: "lg"})
		}
	</div>
}

templ demoJoin() {
	<div class="flex flex-col items-start gap-6">
		@components.Join(components.JoinProps{}) {
			@components.Button(components.ButtonProps{Variant: "secondary"}) {
				Dia
			}
			@components.Button(components.ButtonProps{Variant: "secondary"}) {
				Semana
			}
			@components.Button(components.ButtonProps{Variant: "secondary"}) {
				Mês
			}
		}
		@components.Join(components.JoinProps{Vertical: true}) {
			@components.Button(components.ButtonProps{Variant: "secondary"}) {
				Acima
			}
			@components.Button(components.ButtonProps{Variant: "secondary"}) {
				Meio
			}
			@components.Button(components.ButtonProps{Variant: "secondary"}) {
				Abaixo
			}
		}
	</div>
}
