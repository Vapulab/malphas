package showcase

import "github.com/vapulab/malphas/components"

templ demoRange() {
	<div class="flex max-w-md flex-col gap-6">
		@components.Range(components.RangeProps{ID: "r-vol", Name: "vol", Label: "Volume", Value: 40, ShowValue: true})
		@components.Range(components.RangeProps{ID: "r-qual", Name: "qual", Label: "Quality", Min: 1, Max: 5, Value: 3, ShowValue: true, Variant: "success"})
		@components.Range(components.RangeProps{ID: "r-off", Name: "off", Label: "Disabled", Value: 60, Disabled: true})
	</div>
}

templ demoSwap() {
	<div class="flex items-center gap-4">
		@components.Swap(components.SwapProps{
			Label: "Play or pause",
			On:    swapPauseIcon(),
			Off:   swapPlayIcon(),
		})
		@components.Swap(components.SwapProps{
			Label:  "Favorite",
			Active: true,
			On:     swapStarOn(),
			Off:    swapStarOff(),
		})
	</div>
}

templ swapPlayIcon() {
	<span class="text-lg">&#9654;</span>
}

templ swapPauseIcon() {
	<span class="text-lg">&#10074;&#10074;</span>
}

templ swapStarOn() {
	<span class="text-lg text-warning">&starf;</span>
}

templ swapStarOff() {
	<span class="text-lg text-muted">&star;</span>
}

templ demoTooltip() {
	<div class="flex flex-wrap items-center gap-8 py-8">
		@components.Tooltip(components.TooltipProps{ID: "tip-cima", Text: "Shows above"}) {
			@components.Button(components.ButtonProps{Variant: "secondary", Size: "sm"}) {
				Above
			}
		}
		@components.Tooltip(components.TooltipProps{ID: "tip-baixo", Text: "Shows below", Position: "bottom"}) {
			@components.Button(components.ButtonProps{Variant: "secondary", Size: "sm"}) {
				Below
			}
		}
		@components.Tooltip(components.TooltipProps{ID: "tip-dir", Text: "Shows on the right", Position: "right"}) {
			@components.Button(components.ButtonProps{Variant: "secondary", Size: "sm"}) {
				Right
			}
		}
	</div>
}

templ demoTooltipKeyboard() {
	<div class="flex flex-col gap-3 py-8">
		<p class="text-sm text-muted">
			Tab to the button: the hint opens on focus, no mouse needed. Escape closes it.
		</p>
		@components.Tooltip(components.TooltipProps{ID: "tip-teclado", Text: "Saves without closing the form"}) {
			@components.Button(components.ButtonProps{Size: "sm"}) {
				Save
			}
		}
	</div>
}
