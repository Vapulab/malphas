package showcase

import "github.com/vapulab/malphas/components"

templ demoDropdown() {
	<div class="flex flex-col gap-3">
		<p class="text-sm text-muted">
			Open it and move with ↓ ↑. Escape closes it and returns focus to the trigger.
			Tab closes it too, but follows the page's natural order — a menu does not
			trap focus.
		</p>
		<div class="flex flex-wrap gap-4">
			@components.Dropdown(components.DropdownProps{
				ID:    "dd-acoes",
				Label: "Actions",
				Entries: []components.MenuEntry{
					{Label: "Edit", OnClick: "$dispatch('demo-edit')"},
					{Label: "Duplicate", OnClick: "$dispatch('demo-dup')"},
					components.MenuDivider(),
					{Label: "Delete", OnClick: "$dispatch('demo-del')", Disabled: true},
				},
			})
			@components.Dropdown(components.DropdownProps{
				ID:       "dd-conta",
				Label:    "Account",
				Variant:  "primary",
				Position: "bottom-end",
				Entries: []components.MenuEntry{
					{Label: "Profile", Href: "/"},
					{Label: "Components", Href: "/"},
					components.MenuDivider(),
					{Label: "Sign out", OnClick: "$dispatch('demo-logout')"},
				},
			})
		</div>
	</div>
}

templ demoSelect() {
	<div class="flex max-w-sm flex-col gap-4">
		@components.Select(components.SelectProps{
			ID: "s-plano", Name: "plano", Label: "Plan", Value: "pro",
			Options: []components.SelectOption{
				{Label: "Free", Value: "free"},
				{Label: "Pro", Value: "pro"},
				{Label: "Enterprise", Value: "ent", Disabled: true},
			},
		})
		@components.Select(components.SelectProps{
			ID: "s-pais", Name: "pais", Label: "Country", Placeholder: "Choose…",
			Options: []components.SelectOption{
				{Label: "Canada", Value: "ca"},
				{Label: "Japan", Value: "jp"},
			},
		})
	</div>
}

templ demoCombobox() {
	<div class="flex max-w-sm flex-col gap-4">
		<p class="text-sm text-muted">
			Type to filter — accents are ignored, so "zurich" finds "Zürich".
			↓ ↑ highlight, Enter picks, Escape closes and, pressed again, clears. Text that is not
			an option reverts to the previous selection when you leave the field.
		</p>
		@components.Combobox(components.ComboboxProps{
			ID: "cb-estado", Name: "city", Label: "City", Value: "ymq",
			Placeholder: "Search for a city…",
			Options:     demoCities(),
		})
		@components.Combobox(components.ComboboxProps{
			ID: "cb-plano", Name: "plano", Label: "Plan", Placeholder: "Choose…",
			Options: []components.SelectOption{
				{Label: "Free", Value: "free"},
				{Label: "Pro", Value: "pro"},
				{Label: "Enterprise", Value: "ent", Disabled: true},
			},
		})
	</div>
}

templ demoOTP() {
	<div class="flex flex-col gap-4">
		<p class="text-sm text-muted">
			Type and focus moves forward on its own; backspace in an empty box moves back.
			Pasting the whole code fills every box at once.
		</p>
		@components.OTP(components.OTPProps{Name: "codigo", Label: "Verification code"})
		@components.OTP(components.OTPProps{Name: "pin", Label: "4-digit PIN", Length: 4})
	</div>
}

templ demoCarousel() {
	<div class="max-w-xl">
		<p class="mb-3 text-sm text-muted">
			Tab to the slides area and use ← →. Scrolling respects
			prefers-reduced-motion.
		</p>
		@components.Carousel(components.CarouselProps{
			ID:    "c-demo",
			Label: "Example",
			Slides: []templ.Component{
				carouselSlide("First", "primary"),
				carouselSlide("Second", "success"),
				carouselSlide("Third", "warning"),
			},
		})
	</div>
}

templ carouselSlide(title, variant string) {
	<div class={ "flex h-40 items-center justify-center rounded text-lg font-semibold", carouselSlideClass(variant) }>
		{ title }
	</div>
}

// Reads the page from the request, so clicking actually moves the marker. A
// hardcoded Current made the component look broken: the URL changed and the
// highlight did not.
templ demoPagination() {
	<div class="flex flex-col gap-6">
		<p class="text-sm text-muted">
			Click a page: the URL changes and the marker follows.
		</p>
		@paginationExample("page", "")
	</div>
}

// Each example moves on its own. Sharing one query parameter meant clicking
// here scrolled nothing and moved the interactive demo far above — the page
// looked frozen at the very spot you clicked.
templ demoPaginationEdges() {
	<div class="flex flex-col gap-6">
		<p class="text-sm text-muted">
			Each one starts at an edge and moves on its own, without touching the others.
			Move through the pages with ← → to watch the range collapse and reopen.
		</p>
		@paginationExample("e1", "short — fits whole, never collapses")
		@paginationExample("e2", "long, starting at the beginning")
		@paginationExample("e3", "long, starting at the end")
	</div>
}

// The label describes the example, never its current page — that would go stale
// the moment someone clicks. The position lives in the "X of Y" beside it.
templ paginationExample(param, label string) {
	{{ page, total := paginationPage(ctx, param), paginationTotal(param) }}
	<div class="flex flex-col gap-2">
		<span class="text-xs uppercase tracking-wide text-muted">
			if label != "" {
				{ label } &middot;{ " " }
			}
			page { intToString(page) } of { intToString(total) }
		</span>
		@components.Pagination(components.PaginationProps{
			Current:  page,
			Total:    total,
			Label:    "Pagination " + param,
			BaseHref: paginationHref(ctx, param),
		})
	</div>
}
