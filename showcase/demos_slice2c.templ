package showcase

import "github.com/vapulab/malphas/components"

templ demoCollapse() {
	<div class="flex max-w-lg flex-col gap-3">
		@components.Collapse(components.CollapseProps{ID: "col-1", Title: "What comes in the boilerplate?"}) {
			<p>chi, templ, Tailwind, HTMX and Alpine, with Postgres through pgx and sqlc.</p>
		}
		@components.Collapse(components.CollapseProps{ID: "col-2", Title: "Starts open", Open: true}) {
			<p>The initial state comes from the server, so it does not flicker on load.</p>
		}
	</div>
}

templ demoAccordion() {
	<div class="max-w-lg">
		@components.Accordion(components.AccordionProps{
			ID: "faq",
			Items: []components.AccordionItem{
				{Title: "Does it need Node?", Content: accordionNode()},
				{Title: "Can I use the design system in another project?", Content: accordionReuse(), Open: true},
				{Title: "Does it work without JavaScript?", Content: accordionNoJS()},
			},
		})
	</div>
}

templ demoAccordionExclusive() {
	<div class="max-w-lg">
		@components.Accordion(components.AccordionProps{
			ID:        "faq-x",
			Exclusive: true,
			Items: []components.AccordionItem{
				{Title: "First", Content: accordionExclusiveNote()},
				{Title: "Second", Content: accordionExclusiveNote()},
				{Title: "Third", Content: accordionExclusiveNote()},
			},
		})
	</div>
}

templ accordionNode() {
	<p>No. Tailwind runs from the standalone binary, and HTMX and Alpine are vendored.</p>
}

templ accordionReuse() {
	<p>Yes — it is a standalone Go module, versioned by tag.</p>
}

templ accordionNoJS() {
	<p>The HTML is rendered on the server, but these components rely on Alpine for interaction.</p>
}

templ accordionExclusiveNote() {
	<p>Opening this panel closes the others.</p>
}

templ demoTabs() {
	@components.Tabs(components.TabsProps{
		ID:    "conta",
		Label: "Account settings",
		Items: []components.Tab{
			{Label: "Profile", Content: tabsPerfil()},
			{Label: "Security", Content: tabsSeguranca()},
			{Label: "Billing", Content: tabsFaturamento(), Disabled: true},
		},
	})
}

templ tabsPerfil() {
	<div class="flex max-w-sm flex-col gap-4">
		<p class="text-muted">Move between tabs with the ← → arrows. Home and End go to the ends, and the disabled tab is skipped.</p>
		@components.Input(components.InputProps{ID: "tab-nome", Name: "nome", Label: "Name", Value: "Lincoln"})
	</div>
}

templ tabsSeguranca() {
	<div class="flex max-w-sm flex-col gap-4">
		@components.Toggle(components.ToggleProps{ID: "tab-2fa", Name: "2fa", Label: "Two-factor authentication", Checked: true})
		@components.Input(components.InputProps{ID: "tab-senha", Name: "senha", Type: "password", Label: "New password"})
	</div>
}

templ tabsFaturamento() {
	<p class="text-muted">Available on the Pro plan only.</p>
}
