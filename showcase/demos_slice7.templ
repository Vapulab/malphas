package showcase

import "github.com/vapulab/malphas/components"

templ demoSidebar() {
	<div class="overflow-hidden rounded border border-border">
		@components.Sidebar(components.SidebarProps{
			ID: "sb-app", Label: "Lab navigation", Collapsible: true,
			Groups: []components.SidebarGroup{
				{Label: "Work", Items: []components.SidebarItem{
					{Label: "Protocols", Href: "/components/sidebar", Icon: "◆", Current: true, Badge: "12"},
					{Label: "Results", Href: "/components/sidebar?r=1", Icon: "▲"},
					{Label: "Schedule", Href: "/components/sidebar?r=2", Icon: "●"},
				}},
				{Label: "Account", Items: []components.SidebarItem{
					{Label: "Team", Href: "/components/sidebar?r=3", Icon: "◎"},
					{Label: "Settings", Href: "/components/sidebar?r=4", Icon: "✦"},
				}},
			},
		}) {
			<div class="flex flex-col gap-2 p-6">
				<h2 class="text-lg font-semibold text-fg">Protocols</h2>
				<p class="text-sm text-muted">
					Collapse the bar with the button at its bottom: the choice is remembered
					in this browser. On narrow screens, the bar gives way to the Menu button.
				</p>
			</div>
		}
	</div>
}

templ demoResizablePane(title, body string) {
	<div class="flex h-full flex-col gap-1 p-4">
		<p class="text-sm font-semibold text-fg">{ title }</p>
		<p class="text-sm text-muted">{ body }</p>
	</div>
}

templ demoResizable() {
	<div class="flex flex-col gap-6">
		<p class="text-sm text-muted">
			Drag the divider, or Tab to it and use the arrows (Shift for 1% steps),
			Home and End. The first example's size is remembered in this browser.
		</p>
		<div class="h-56 overflow-hidden rounded border border-border">
			@components.Resizable(components.ResizableProps{
				ID: "rz-editor", Label: "Step list width", DefaultSize: 35, Min: 20, Max: 70,
				First:  demoResizablePane("Steps", "1. Prepare samples · 2. Extract RNA · 3. PCR"),
				Second: demoResizablePane("Editor", "Details of the selected step."),
			})
		</div>
		<div class="h-72 overflow-hidden rounded border border-border">
			@components.Resizable(components.ResizableProps{
				ID: "rz-vertical", Label: "Log height", Vertical: true, DefaultSize: 60,
				First:  demoResizablePane("Chart", "Amplification curve."),
				Second: demoResizablePane("Log", "Cycle 32: threshold reached."),
			})
		</div>
	</div>
}
