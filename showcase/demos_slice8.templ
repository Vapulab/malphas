package showcase

import "github.com/vapulab/malphas/components"

templ demoBubble() {
	<div role="group" aria-label="Sample conversation" class="flex max-w-md flex-col gap-1 rounded-lg border border-border bg-surface p-4">
		@components.Bubble(components.BubbleProps{Group: "first"}) {
			The curve for cycle 32 came out above the threshold.
		}
		@components.Bubble(components.BubbleProps{Group: "last", Reactions: []components.BubbleReaction{{Emoji: "👀", Label: "Looking", Count: 2}}}) {
			Should I rerun it first thing tomorrow?
		}
		@components.Bubble(components.BubbleProps{Variant: "primary", Align: "end"}) {
			Rerun it, and set aside a control aliquot.
		}
		@components.Bubble(components.BubbleProps{Variant: "outline"}) {
			Quote: "set aside a control aliquot"
		}
	</div>
}

templ demoMarker() {
	<div class="flex max-w-md flex-col gap-2">
		@components.Marker(components.MarkerProps{Variant: "separator"}) {
			Yesterday
		}
		@components.Marker(components.MarkerProps{Icon: "●"}) {
			Amara Okafor joined the conversation
		}
		@components.Marker(components.MarkerProps{Variant: "border", Status: true, Icon: "⟳"}) {
			Generating the protocol summary…
		}
	</div>
}

templ demoMessage() {
	<div role="group" aria-label="Sample conversation" class="flex max-w-lg flex-col rounded-lg border border-border bg-surface p-4">
		@components.Message(components.MessageProps{Author: "Amara Okafor", Initials: "AO", Time: "14:02", Datetime: "2026-10-10T14:02", Group: "first"}) {
			The curve for cycle 32 came out above the threshold.
		}
		@components.Message(components.MessageProps{Author: "Amara Okafor", Initials: "AO", Time: "14:02", Datetime: "2026-10-10T14:02", Group: "last"}) {
			Should I rerun it first thing tomorrow?
		}
		@components.Message(components.MessageProps{Author: "You", Initials: "ME", Time: "14:05", Datetime: "2026-10-10T14:05", Align: "end", Reactions: []components.BubbleReaction{{Emoji: "👍", Label: "Like", Count: 1}}}) {
			Rerun it, and set aside a control aliquot.
		}
	</div>
}

templ demoAttachmentRemove(name string) {
	<button type="button" aria-label={ "Remove " + name } class="rounded px-1.5 text-muted hover:bg-muted/10 hover:text-fg focus:outline-none focus-visible:ring-2 focus-visible:ring-primary/50">&times;</button>
}

templ demoAttachmentRetry(name string) {
	<button type="button" aria-label={ "Try again: " + name } class="rounded px-2 py-1 text-xs font-medium text-primary hover:bg-primary/10 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary/50">Try again</button>
}

templ demoAttachment() {
	@components.AttachmentGroup(components.AttachmentGroupProps{
		Label: "Message attachments",
		Items: []components.AttachmentProps{
			{Name: "protocol-v2.pdf", Meta: "PDF · 2.4 MB", State: "done", Href: "/components/attachment", Actions: demoAttachmentRemove("protocol-v2.pdf")},
			{Name: "cycle-32-curve.png", Meta: "PNG · 840 KB", State: "uploading", Progress: 45, Actions: demoAttachmentRemove("cycle-32-curve.png")},
			{Name: "results.csv", Meta: "CSV · 12 KB", State: "processing"},
			{Name: "samples.xlsx", Meta: "XLSX · 1.1 MB", State: "error", Error: "Connection failed.", Actions: demoAttachmentRetry("samples.xlsx")},
		},
	})
}

// ChatMessageView renders one demo message; the demo endpoint answers with it.
templ ChatMessageView(m ChatMessage) {
	@components.Message(components.MessageProps{
		Author: m.Author, Initials: m.Initials, Time: m.Time,
		Align: map[bool]string{true: "end", false: "start"}[m.Mine],
	}) {
		{ m.Text }
	}
}

const chatEndpoint = "/components/message-scroller/mensagem"

templ demoMessageScroller() {
	// x-data: the streaming button's x-on:click needs an Alpine scope above
	// it, or Alpine ignores the directive without a word.
	<div class="flex flex-col gap-3" x-data>
		<p class="text-sm text-muted">
			Scroll up and ask for new messages: your position stays put, and the button counts what
			arrived. "Load earlier" adds to the top without pushing what you are reading.
		</p>
		<div class="flex flex-wrap gap-2">
			@components.Button(components.ButtonProps{Size: "sm", Attrs: templ.Attributes{
				"id": "chat-nova", "hx-get": chatEndpoint, "hx-target": "#chat-demo-content", "hx-swap": "beforeend",
			}}) {
				Receive a message
			}
			@components.Button(components.ButtonProps{Size: "sm", Variant: "secondary", Attrs: templ.Attributes{
				"id": "chat-antigas", "hx-get": chatEndpoint + "?antes=1", "hx-target": "#chat-demo-content", "hx-swap": "afterbegin",
				// Marks this as a history load: the log stays quiet for it.
				"data-history": true,
			}}) {
				Load earlier
			}
			@components.Button(components.ButtonProps{Size: "sm", Variant: "secondary", Attrs: templ.Attributes{
				"id":         "chat-stream",
				// The streaming message is aria-busy while it grows, so a screen
				// reader announces it once, complete, instead of word by word.
				"x-on:click": "const m = [...document.querySelectorAll('#chat-demo-content [data-message]')].at(-1); if (m) { const b = m.querySelector('[data-bubble-content]'); m.setAttribute('aria-busy', 'true'); let i = 0; const t = setInterval(() => { b.append(' word'); if (++i >= 30) { clearInterval(t); m.removeAttribute('aria-busy') } }, 60) }",
			}}) {
				Simulate streaming
			}
		</div>
		<div class="h-96 overflow-hidden rounded border border-border">
			@components.MessageScroller(components.MessageScrollerProps{ID: "chat-demo", Label: "Lab conversation"}) {
				@components.Marker(components.MarkerProps{Variant: "separator"}) {
					Today
				}
				for i := 0; i < 12; i++ {
					@ChatMessageView(DemoChatMessage(i))
				}
			}
		</div>
	</div>
}
