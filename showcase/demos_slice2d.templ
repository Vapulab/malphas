package showcase

import "github.com/vapulab/malphas/components"

templ demoCountdown() {
	<div class="flex flex-col gap-6">
		@components.Countdown(components.CountdownProps{Seconds: 3723})
		@components.Countdown(components.CountdownProps{Seconds: 90, Format: "mm:ss", Size: "lg"})
		@components.Countdown(components.CountdownProps{Seconds: 45, Format: "mm:ss", Size: "sm"})
	</div>
}

// The end event bubbles, so anything up the tree can react to it — here an
// Alpine wrapper swaps the message.
templ demoCountdownOnEnd() {
	<div class="flex items-center gap-4" x-data="{ done: false }" x-on:countdown-end="done = true">
		@components.Countdown(components.CountdownProps{Seconds: 5, Format: "mm:ss", OnEnd: "notify"})
		<span x-show="!done" class="text-sm text-muted">Waiting…</span>
		<span x-show="done" style="display:none">
			@components.Badge(components.BadgeProps{Variant: "success"}) {
				Time is up
			}
		</span>
	</div>
}
