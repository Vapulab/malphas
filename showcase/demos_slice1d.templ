package showcase

import "github.com/vapulab/malphas/components"

type demoRow struct {
	Name   string
	Env    string
	Status string
	Badge  string
}

var demoRows = []demoRow{
	{"vapulab-api", "produção", "Ativo", "success"},
	{"vapulab-web", "produção", "Ativo", "success"},
	{"vapulab-jobs", "staging", "Degradado", "warning"},
	{"vapulab-etl", "staging", "Parado", "danger"},
}

templ demoTableRows() {
	for _, r := range demoRows {
		@components.TR() {
			@components.TD(components.TDProps{Class: "font-medium"}) {
				{ r.Name }
			}
			@components.TD(components.TDProps{}) {
				{ r.Env }
			}
			@components.TD(components.TDProps{}) {
				@components.Badge(components.BadgeProps{Variant: r.Badge, Size: "sm"}) {
					{ r.Status }
				}
			}
		}
	}
}

templ demoTableHead() {
	@components.THead() {
		@components.TR() {
			@components.TH(components.THProps{}) {
				Serviço
			}
			@components.TH(components.THProps{}) {
				Ambiente
			}
			@components.TH(components.THProps{}) {
				Status
			}
		}
	}
}

templ demoTable() {
	@components.Table(components.TableProps{}) {
		@demoTableHead()
		@components.TBody() {
			@demoTableRows()
		}
	}
}

templ demoTableZebraCompact() {
	@components.Table(components.TableProps{Zebra: true, Compact: true}) {
		@demoTableHead()
		@components.TBody() {
			@demoTableRows()
		}
	}
}

templ demoHero() {
	@components.Hero(components.HeroProps{Class: "border border-border bg-primary/5"}) {
		<h1 class="text-3xl font-bold text-fg">Construa em Go, sem npm</h1>
		<p class="mt-3 text-muted">
			chi, templ, Tailwind, HTMX e Alpine — com um design system próprio e reaproveitável.
		</p>
		<div class="mt-6 flex justify-center gap-3">
			@components.Button(components.ButtonProps{}) {
				Começar
			}
			@components.Button(components.ButtonProps{Variant: "secondary"}) {
				Documentação
			}
		</div>
	}
}
