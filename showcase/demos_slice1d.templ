package showcase

import "github.com/vapulab/malphas/components"

type demoRow struct {
	Name   string
	Env    string
	Status string
	Badge  string
}

var demoRows = []demoRow{
	{"vapulab-api", "production", "Active", "success"},
	{"vapulab-web", "production", "Active", "success"},
	{"vapulab-jobs", "staging", "Degraded", "warning"},
	{"vapulab-etl", "staging", "Stopped", "danger"},
}

templ demoTableRows() {
	for _, r := range demoRows {
		@components.TR() {
			@components.TD(components.TDProps{Class: "font-medium"}) {
				{ r.Name }
			}
			@components.TD(components.TDProps{}) {
				{ r.Env }
			}
			@components.TD(components.TDProps{}) {
				@components.Badge(components.BadgeProps{Variant: r.Badge, Size: "sm"}) {
					{ r.Status }
				}
			}
		}
	}
}

templ demoTableHead() {
	@components.THead() {
		@components.TR() {
			@components.TH(components.THProps{}) {
				Service
			}
			@components.TH(components.THProps{}) {
				Environment
			}
			@components.TH(components.THProps{}) {
				Status
			}
		}
	}
}

templ demoTable() {
	@components.Table(components.TableProps{}) {
		@demoTableHead()
		@components.TBody() {
			@demoTableRows()
		}
	}
}

templ demoTableZebraCompact() {
	@components.Table(components.TableProps{Zebra: true, Compact: true}) {
		@demoTableHead()
		@components.TBody() {
			@demoTableRows()
		}
	}
}

templ demoHero() {
	@components.Hero(components.HeroProps{Class: "border border-border bg-primary/5"}) {
		<h1 class="text-3xl font-bold text-fg">Build in Go, without npm</h1>
		<p class="mt-3 text-muted">
			chi, templ, Tailwind, HTMX and Alpine — with a design system of your own that you can reuse.
		</p>
		<div class="mt-6 flex justify-center gap-3">
			@components.Button(components.ButtonProps{}) {
				Get started
			}
			@components.Button(components.ButtonProps{Variant: "secondary"}) {
				Documentation
			}
		</div>
	}
}
