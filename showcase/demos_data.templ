package showcase

import "github.com/vapulab/malphas/components"

templ demoCard() {
	@components.Card(components.CardProps{}) {
		<h3 class="mb-1 font-semibold text-fg">Card title</h3>
		<p class="text-muted">A container that groups related content.</p>
	}
}

templ demoCardWithActions() {
	@components.Card(components.CardProps{Class: "max-w-sm"}) {
		<h3 class="mb-1 font-semibold text-fg">Pro plan</h3>
		<p class="mb-4 text-muted">Everything in the free plan, with no limits.</p>
		@components.Button(components.ButtonProps{Size: "sm"}) {
			Subscribe
		}
	}
}

templ demoInput() {
	<div class="max-w-sm">
		@components.Input(components.InputProps{
			ID:          "demo-email",
			Name:        "email",
			Label:       "Email",
			Type:        "email",
			Placeholder: "you@example.com",
		})
	</div>
}

templ demoInputWithValue() {
	<div class="max-w-sm">
		@components.Input(components.InputProps{
			ID:    "demo-nome",
			Name:  "nome",
			Label: "Name",
			Value: "Lincoln",
		})
	</div>
}
