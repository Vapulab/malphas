package showcase

import "github.com/vapulab/malphas/components"

templ demoCard() {
	@components.Card(components.CardProps{}) {
		<h3 class="mb-1 font-semibold text-fg">Título do card</h3>
		<p class="text-muted">Um contêiner para agrupar conteúdo relacionado.</p>
	}
}

templ demoCardWithActions() {
	@components.Card(components.CardProps{Class: "max-w-sm"}) {
		<h3 class="mb-1 font-semibold text-fg">Plano Pro</h3>
		<p class="mb-4 text-muted">Tudo do plano gratuito, sem limites.</p>
		@components.Button(components.ButtonProps{Size: "sm"}) {
			Assinar
		}
	}
}

templ demoInput() {
	<div class="max-w-sm">
		@components.Input(components.InputProps{
			ID:          "demo-email",
			Name:        "email",
			Label:       "Email",
			Type:        "email",
			Placeholder: "voce@exemplo.com",
		})
	</div>
}

templ demoInputWithValue() {
	<div class="max-w-sm">
		@components.Input(components.InputProps{
			ID:    "demo-nome",
			Name:  "nome",
			Label: "Nome",
			Value: "Lincoln",
		})
	</div>
}
