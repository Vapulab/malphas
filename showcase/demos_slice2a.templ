package showcase

import "github.com/vapulab/malphas/components"

templ demoToggle() {
	<div class="flex flex-col gap-4">
		@components.Toggle(components.ToggleProps{ID: "t-notif", Name: "notif", Label: "Email notifications"})
		@components.Toggle(components.ToggleProps{ID: "t-beta", Name: "beta", Label: "Beta features", Checked: true})
		@components.Toggle(components.ToggleProps{ID: "t-off", Name: "off", Label: "Not available on your plan", Disabled: true})
	</div>
}

templ demoCheckbox() {
	<div class="flex flex-col gap-3">
		@components.Checkbox(components.CheckboxProps{ID: "c-termos", Name: "termos", Value: "yes", Label: "I accept the terms of use"})
		@components.Checkbox(components.CheckboxProps{ID: "c-news", Name: "news", Label: "Send me product updates", Checked: true})
		@components.Checkbox(components.CheckboxProps{ID: "c-off", Name: "off", Label: "Disabled", Disabled: true})
	</div>
}

templ demoCheckboxIndeterminate() {
	<div class="flex flex-col gap-3">
		@components.Checkbox(components.CheckboxProps{ID: "c-all", Name: "all", Label: "Select all", Indeterminate: true})
		<div class="ml-6 flex flex-col gap-3">
			@components.Checkbox(components.CheckboxProps{ID: "c-a", Name: "item", Value: "a", Label: "Item A", Checked: true})
			@components.Checkbox(components.CheckboxProps{ID: "c-b", Name: "item", Value: "b", Label: "Item B"})
		</div>
	</div>
}

templ demoRadio() {
	@components.Radio(components.RadioProps{
		Name:  "plano",
		Label: "Plan",
		Value: "pro",
		Options: []components.RadioOption{
			{Label: "Free", Value: "free"},
			{Label: "Pro", Value: "pro"},
			{Label: "Enterprise", Value: "ent", Disabled: true},
		},
	})
}

templ demoRadioVertical() {
	@components.Radio(components.RadioProps{
		Name:     "entrega",
		Label:    "Delivery method",
		Value:    "normal",
		Vertical: true,
		Options: []components.RadioOption{
			{Label: "Pick up in store", Value: "loja"},
			{Label: "Standard delivery", Value: "normal"},
			{Label: "Express delivery", Value: "express"},
		},
	})
}

templ demoRating() {
	<div class="flex flex-col gap-4">
		@components.Rating(components.RatingProps{Name: "nota", Value: 3})
		@components.Rating(components.RatingProps{Name: "nota10", Value: 7, Max: 10})
	</div>
}

templ demoRatingReadOnly() {
	<div class="flex items-center gap-3">
		@components.Rating(components.RatingProps{Value: 4, ReadOnly: true})
		<span class="text-sm text-muted">4 out of 5 — 128 reviews</span>
	</div>
}

// A real form, so the hidden inputs can be seen doing their job: submit and the
// values show up as query parameters.
templ demoFormSubmit() {
	<form method="get" action="/components/toggle" class="flex flex-col items-start gap-4">
		@components.Toggle(components.ToggleProps{ID: "f-toggle", Name: "toggle", Label: "Toggle"})
		@components.Checkbox(components.CheckboxProps{ID: "f-check", Name: "check", Value: "yes", Label: "Checkbox"})
		@components.Radio(components.RadioProps{
			Name:  "radio",
			Label: "Radio",
			Value: "b",
			Options: []components.RadioOption{
				{Label: "A", Value: "a"},
				{Label: "B", Value: "b"},
			},
		})
		@components.Rating(components.RatingProps{Name: "rating", Value: 3})
		@components.Button(components.ButtonProps{Type: "submit", Size: "sm"}) {
			Submit
		}
	</form>
}
