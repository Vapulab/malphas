package components

type HeroProps struct {
	Class string // extra classes, e.g. a background
	Attrs templ.Attributes
}

// Hero is the headline block at the top of a page. It only handles the framing
// — spacing, centring and max width — leaving the content to the caller.
templ Hero(props HeroProps) {
	<section
		class={ "flex flex-col items-center justify-center gap-4 rounded px-6 py-16 text-center",
			props.Class }
		{ props.Attrs... }
	>
		<div class="max-w-2xl">
			{ children... }
		</div>
	</section>
}
