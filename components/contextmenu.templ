package components

type ContextMenuProps struct {
	ID      string
	Label   string // accessible name for the menu
	Entries []MenuEntry
	Attrs   templ.Attributes
}

func (p ContextMenuProps) menuID() string { return p.ID + "-menu" }

func (p ContextMenuProps) hintID() string { return p.ID + "-hint" }

// ContextMenu attaches a menu of actions to an area, opened with the right
// mouse button at the pointer.
//
// A right-click alone is invisible to keyboard and screen reader users, so the
// area is focusable, opens the same menu with Shift+F10 or the Menu key, and
// says so through aria-describedby. Anything in the menu should also be
// reachable another way; this is a shortcut, not the only door.
//
// The menu is the only overlay that opens at a point rather than off a
// trigger, so it is the one that measures the viewport: contextMenu() pushes
// it back inside when the click lands near an edge. Items and arrow keys are
// Dropdown's (dropdownItem, rovingList).
templ ContextMenu(props ContextMenuProps) {
	<div
		x-data="contextMenu"
		x-on:pointerdown.window="onWindowPointerDown($event)"
		{ props.Attrs... }
	>
		<div
			x-ref="target"
			tabindex="0"
			aria-describedby={ props.hintID() }
			x-on:contextmenu.prevent="openAt($event.clientX, $event.clientY)"
			x-on:keydown="onTargetKeydown($event)"
			class="rounded focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/50"
		>
			{ children... }
		</div>
		<span id={ props.hintID() } class="sr-only">{ msg(ctx).ContextMenuHint }</span>
		<div
			id={ props.menuID() }
			role="menu"
			aria-label={ props.Label }
			x-ref="menu"
			x-on:keydown="onMenuKeydown($event)"
			x-show="open"
			style="display:none"
			x-bind:style="{ left: x + 'px', top: y + 'px' }"
			class="fixed z-50 min-w-48 rounded border border-border bg-surface py-1 shadow-lg"
		>
			for i, e := range props.Entries {
				if e.isDivider() {
					<div role="separator" class="my-1 h-px bg-border"></div>
				} else {
					@dropdownItem(e, i)
				}
			}
		</div>
	</div>
}
