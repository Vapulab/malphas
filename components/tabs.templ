package components

import "strconv"

type Tab struct {
	Label    string
	Content  templ.Component
	Disabled bool
}

type TabsProps struct {
	// ID prefixes the generated tab and panel ids, so two tab sets on one page
	// do not collide.
	ID    string
	Label string // accessible name for the tablist
	Items []Tab
	Attrs templ.Attributes
}

func (p TabsProps) tabID(i int) string   { return p.ID + "-tab-" + strconv.Itoa(i) }
func (p TabsProps) panelID(i int) string { return p.ID + "-panel-" + strconv.Itoa(i) }

// selected is the first tab that is not disabled. Defaulting to index 0 blindly
// would select a disabled tab and leave the whole set unusable.
func (p TabsProps) selected() int {
	for i, t := range p.Items {
		if !t.Disabled {
			return i
		}
	}
	return 0
}

// Tabs follows the WAI-ARIA tabs pattern: Tab reaches the tablist once, then
// the arrows move between tabs, Home and End jump to the ends, and disabled
// tabs are skipped. That behavior comes from rovingList, shared with Radio and
// Rating.
templ Tabs(props TabsProps) {
	<div x-data={ "tabs(" + intJS(props.selected()) + ")" } { props.Attrs... }>
		<div
			role="tablist"
			if props.Label != "" {
				aria-label={ props.Label }
			}
			class="flex gap-1 border-b border-border"
			x-on:keydown="onKeydown"
		>
			for i, item := range props.Items {
				<button
					type="button"
					role="tab"
					id={ props.tabID(i) }
					aria-controls={ props.panelID(i) }
					aria-selected={ ariaBool(i == props.selected()) }
					x-bind:aria-selected={ "isActive(" + intJS(i) + ") ? 'true' : 'false'" }
					data-roving-item={ intJS(i) }
					if item.Disabled {
						data-roving-disabled
						disabled
					}
					tabindex={ rovingTabindex(i, props.selected()) }
					x-bind:tabindex={ "tabindex(" + intJS(i) + ")" }
					x-on:click={ "select(" + intJS(i) + ")" }
					class="-mb-px border-b-2 border-transparent px-4 py-2 text-sm font-medium text-muted transition-colors hover:text-fg focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-primary/50 disabled:cursor-not-allowed disabled:opacity-50"
					x-bind:class={ "isActive(" + intJS(i) + ") && 'border-primary text-fg'" }
				>
					{ item.Label }
				</button>
			}
		</div>
		for i, item := range props.Items {
			// `hidden` rather than x-show: an inactive tabpanel should leave the
			// accessibility tree entirely, not just stop being painted. Alpine
			// drives the same attribute, so there is one mechanism, not two.
			<div
				id={ props.panelID(i) }
				role="tabpanel"
				aria-labelledby={ props.tabID(i) }
				tabindex="0"
				if i != props.selected() {
					hidden
				}
				x-bind:hidden={ "!isActive(" + intJS(i) + ")" }
				class="py-4 text-sm text-fg focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/50"
			>
				if item.Content != nil {
					@item.Content
				}
			</div>
		}
	</div>
}
