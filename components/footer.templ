package components

type FooterLink struct {
	Label    string
	Href     string
	External bool
}

type FooterColumn struct {
	Title string
	Links []FooterLink
}

type FooterProps struct {
	Columns []FooterColumn
	Note    string // bottom line, e.g. copyright
	Class   string
	Attrs   templ.Attributes
}

// Footer is the site's structural footer. The children sit on the left — that
// is where the brand goes.
//
// The role is explicit on purpose: <footer> only maps to contentinfo
// automatically when it is a direct child of <body>, and here it is nested in
// the page shell. Without the role, screen readers do not offer the shortcut.
//
// The links delegate to Link instead of writing <a>: that is where href
// sanitizing and the safe rel for external links live.
templ Footer(props FooterProps) {
	<footer role="contentinfo" class={ "border-t border-border", props.Class } { props.Attrs... }>
		<div class="mx-auto flex max-w-5xl flex-col gap-8 px-4 py-12 md:flex-row md:justify-between">
			<div class="text-sm text-muted">
				{ children... }
			</div>
			<div class="flex flex-wrap gap-12">
				for _, col := range props.Columns {
					<nav class="flex flex-col gap-2" aria-label={ col.Title }>
						<span class="text-xs font-semibold uppercase tracking-wider text-muted">{ col.Title }</span>
						for _, l := range col.Links {
							@Link(LinkProps{Href: l.Href, Variant: "muted", External: l.External}) {
								{ l.Label }
							}
						}
					</nav>
				}
			</div>
		</div>
		if props.Note != "" {
			<div class="border-t border-border">
				<p class="mx-auto max-w-5xl px-4 py-4 text-xs text-muted">{ props.Note }</p>
			</div>
		}
	</footer>
}
