package components

type OTPProps struct {
	Name   string
	Label  string
	Length int // default 6
	Attrs  templ.Attributes
}

func (p OTPProps) length() int {
	if p.Length > 0 {
		return p.Length
	}
	return 6
}

// OTP is a row of single-character boxes over one hidden field, following the
// same shape as the slice-2 form controls: the visible part is Alpine, the
// submitted value is a real input.
//
// The first box carries autocomplete="one-time-code" and inputmode="numeric".
// That pair is what makes iOS and Android offer the SMS code straight from the
// keyboard — the whole point of the component on mobile, and easy to leave out
// because nothing looks broken without it.
templ OTP(props OTPProps) {
	<div
		class="flex flex-col gap-2"
		x-data={ "otp(" + intJS(props.length()) + ")" }
		{ props.Attrs... }
	>
		if props.Label != "" {
			<span class="text-sm font-medium text-fg" id={ props.Name + "-label" }>{ props.Label }</span>
		}
		<div
			class="flex gap-2"
			if props.Label != "" {
				role="group"
				aria-labelledby={ props.Name + "-label" }
			}
		>
			for i := 0; i < props.length(); i++ {
				<input
					type="text"
					inputmode="numeric"
					if i == 0 {
						autocomplete="one-time-code"
					} else {
						autocomplete="off"
					}
					maxlength="1"
					aria-label={ otpDigitLabel(i+1, props.length()) }
					data-otp-index={ intJS(i) }
					x-on:input={ "onInput($event, " + intJS(i) + ")" }
					x-on:keydown={ "onKeydown($event, " + intJS(i) + ")" }
					x-on:paste.prevent={ "onPaste($event)" }
					class="size-11 rounded border border-border bg-surface text-center text-lg font-medium text-fg focus:outline-none focus:ring-2 focus:ring-primary/50"
				/>
			}
		</div>
		<input type="hidden" name={ props.Name } x-bind:value="value"/>
	</div>
}
