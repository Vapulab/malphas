package components

type ToastProps struct {
	Message string
	Variant string // success | error (default success)
}

templ Toast(props ToastProps) {
	<div
		x-data="{ show: true }"
		x-show="show"
		x-init="setTimeout(() => show = false, 3000)"
		class={ "fixed bottom-4 right-4 z-50 rounded px-4 py-3 text-sm text-white shadow-lg",
			templ.KV("bg-primary", or(props.Variant, "success") == "success"),
			templ.KV("bg-danger", props.Variant == "error") }
	>
		{ props.Message }
	</div>
}
