package components

type ToastProps struct {
	Message string
	Variant string // success | error (default success)
}

templ Toast(props ToastProps) {
	// Each fill takes its own -fg token, never text-white: the dark theme
	// lightens primary and danger, and white on the lighter tones fails AA.
	<div
		x-data="{ show: true }"
		x-show="show"
		x-init="setTimeout(() => show = false, 3000)"
		class={ "fixed bottom-4 right-4 z-50 rounded px-4 py-3 text-sm shadow-lg",
			templ.KV("bg-primary text-primary-fg", or(props.Variant, "success") == "success"),
			templ.KV("bg-danger text-danger-fg", props.Variant == "error") }
	>
		{ props.Message }
	</div>
}
