package components

type MessageScrollerProps struct {
	ID    string // the content element is ID + "-content": the target for new messages
	Label string // accessible name of the conversation log
	Attrs templ.Attributes
}

func (p MessageScrollerProps) contentID() string { return p.ID + "-content" }

// MessageScroller is a conversation transcript that behaves like a chat:
//
//   - New messages are followed only while the reader is at the end. If they
//     scrolled up to read, their place is kept and a button offers the way
//     back, counting what arrived meanwhile.
//   - Older messages loaded at the top do not push the page: what was on
//     screen stays on the same pixel.
//   - Text streaming into the last message keeps the end in view.
//
// It does not care how messages arrive — hx-swap="beforeend" into the content
// element, SSE, or plain DOM calls — because messageScroller() observes the
// content itself (MutationObserver). The browser's own scroll anchoring is
// switched off ([overflow-anchor:none]) so the two never correct the same
// shift twice.
//
// The viewport is role="log", which is polite by nature: new messages are
// read out without interrupting.
templ MessageScroller(props MessageScrollerProps) {
	<div class="relative flex h-full min-h-0 flex-col" x-data="messageScroller" { props.Attrs... }>
		<div
			x-ref="viewport"
			role="log"
			aria-live="polite"
			if props.Label != "" {
				aria-label={ props.Label }
			}
			tabindex="0"
			x-on:scroll="onScroll()"
			class="min-h-0 flex-1 overflow-y-auto [overflow-anchor:none] focus:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-primary/50"
		>
			<div id={ props.contentID() } x-ref="content" class="flex flex-col gap-1 p-4">
				{ children... }
			</div>
		</div>
		<button
			type="button"
			x-show="!atBottom"
			style="display:none"
			x-on:click="toEnd()"
			class="absolute bottom-3 left-1/2 inline-flex -translate-x-1/2 items-center gap-2 rounded-full border border-border bg-surface px-4 py-1.5 text-sm font-medium text-fg shadow-lg hover:bg-muted/10 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary/50"
		>
			<span aria-hidden="true">&#8595;</span>
			Ir para o fim
			<span x-show="unread > 0" style="display:none" x-text="'(' + unread + (unread === 1 ? ' nova)' : ' novas)')" class="text-primary"></span>
		</button>
	</div>
}
