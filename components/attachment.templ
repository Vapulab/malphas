package components

import "context"

type AttachmentProps struct {
	ID       string
	Name     string
	Meta     string // type and size, e.g. "PDF · 2.4 MB"
	Kind     string // file | image (default file)
	Src      string // image preview, for Kind image
	Href     string // where the finished file opens
	State    string // idle | uploading | processing | error | done (default idle)
	Progress int    // 0–100, while uploading
	Error    string // shown when State is error
	Actions  templ.Component
	Attrs    templ.Attributes
}

func (p AttachmentProps) state() string { return or(p.State, "idle") }

func (p AttachmentProps) statusText(ctx context.Context) string {
	switch p.state() {
	case "uploading":
		return msg(ctx).UploadingStatus(clampInt(p.Progress, 0, 100))
	case "processing":
		return msg(ctx).ProcessingStatus
	}
	return ""
}

// Attachment is a file or image in a composer, a message or an upload list,
// with its upload state.
//
// The state is text, not just a bar: "Uploading 45%" and "Processing…" live in
// role="status", an error in role="alert", so they are announced as they
// change. The name only becomes a link once the file is done — a link to a
// half-uploaded file is a dead end. Actions (remove, retry) stay reachable in
// every state, an error above all.
templ Attachment(props AttachmentProps) {
	<div
		if props.ID != "" {
			id={ props.ID }
		}
		class={ "flex w-64 shrink-0 items-start gap-3 rounded border bg-surface p-3",
			templ.KV("border-danger", props.state() == "error"),
			templ.KV("border-border", props.state() != "error") }
		{ props.Attrs... }
	>
		if props.Kind == "image" && props.Src != "" {
			<img src={ props.Src } alt="" class="size-10 shrink-0 rounded object-cover"/>
		} else {
			<span aria-hidden="true" class="flex size-10 shrink-0 items-center justify-center rounded bg-muted/10 text-lg text-muted">&#9636;</span>
		}
		<div class="flex min-w-0 flex-1 flex-col gap-1">
			if props.state() == "done" && props.Href != "" {
				<a href={ templ.URL(props.Href) } class="truncate text-sm font-medium text-fg underline-offset-2 hover:underline focus:outline-none focus-visible:ring-2 focus-visible:ring-primary/50">{ props.Name }</a>
			} else {
				<p class="truncate text-sm font-medium text-fg">{ props.Name }</p>
			}
			if props.Meta != "" {
				<p class="truncate text-xs text-muted">{ props.Meta }</p>
			}
			switch props.state() {
				case "uploading":
					@Progress(ProgressProps{Value: clampInt(props.Progress, 0, 100), Attrs: templ.Attributes{"aria-label": msg(ctx).UploadOf(props.Name)}})
				case "processing":
					@Progress(ProgressProps{Indeterminate: true, Attrs: templ.Attributes{"aria-label": msg(ctx).ProcessingOf(props.Name)}})
				case "error":
					<p role="alert" class="text-xs text-danger">{ or(props.Error, msg(ctx).SendFailed) }</p>
			}
			// Present in every state, empty when there is nothing to say: a live
			// region born together with its text is often not announced, so the
			// region must already exist when the text changes. Callers updating
			// a card in place should swap its contents, not the whole card.
			<p role="status" class="text-xs text-muted empty:hidden">{ props.statusText(ctx) }</p>
		</div>
		if props.Actions != nil {
			<div class="flex shrink-0 items-center gap-1">
				@props.Actions
			</div>
		}
	</div>
}

type AttachmentGroupProps struct {
	Label string // names the scrollable row
	Items []AttachmentProps
	Attrs templ.Attributes
}

// AttachmentGroup is a row of attachments that scrolls sideways, inside a
// ScrollArea so the keyboard can scroll it too.
templ AttachmentGroup(props AttachmentGroupProps) {
	@ScrollArea(ScrollAreaProps{Label: or(props.Label, msg(ctx).Attachments), Horizontal: true, Attrs: props.Attrs}) {
		<ul class="flex w-max gap-2 p-1">
			for _, it := range props.Items {
				<li>
					@Attachment(it)
				</li>
			}
		</ul>
	}
}
