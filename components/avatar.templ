package components

import "context"

type AvatarProps struct {
	Src      string
	Alt      string
	Initials string // fallback shown when Src is empty
	Size     string // sm | md | lg (default md)
	Shape    string // circle | square (default circle)
	Status   string // online | offline | busy — omitted when empty
	Attrs    templ.Attributes
}

func (p AvatarProps) sizeClasses() string {
	return map[string]string{
		"sm": "size-8 text-xs",
		"md": "size-10 text-sm",
		"lg": "size-14 text-base",
	}[or(p.Size, "md")]
}

func (p AvatarProps) shapeClasses() string {
	if or(p.Shape, "circle") == "square" {
		return "rounded"
	}
	return "rounded-full"
}

func (p AvatarProps) statusClasses() string {
	return map[string]string{
		"online":  "bg-success",
		"offline": "bg-muted",
		"busy":    "bg-danger",
	}[p.Status]
}

func (p AvatarProps) statusLabel(ctx context.Context) string {
	m := msg(ctx)
	return map[string]string{
		"online":  m.StatusOnline,
		"offline": m.StatusOffline,
		"busy":    m.StatusBusy,
	}[p.Status]
}

// Avatar shows an image, or the initials when there is no image. The status dot
// is colour-only, so it carries a text label for screen readers.
templ Avatar(props AvatarProps) {
	<span class="relative inline-flex shrink-0" { props.Attrs... }>
		if props.Src != "" {
			<img
				src={ props.Src }
				alt={ props.Alt }
				class={ "object-cover", props.sizeClasses(), props.shapeClasses() }
			/>
		} else {
			<span
				class={ "inline-flex items-center justify-center bg-muted/20 font-medium text-fg",
					props.sizeClasses(), props.shapeClasses() }
				aria-hidden={ templ.KV("true", props.Alt == "") }
			>
				{ props.Initials }
			</span>
		}
		if props.Status != "" {
			<span class={ "absolute bottom-0 right-0 size-2.5 rounded-full ring-2 ring-surface", props.statusClasses() }></span>
			<span class="sr-only">{ props.statusLabel(ctx) }</span>
		}
	</span>
}
