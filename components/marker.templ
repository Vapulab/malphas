package components

type MarkerProps struct {
	Variant string // default | border | separator
	Icon    string // short glyph, decorative
	Status  bool   // an update as it happens: announced politely (role="status")
	Attrs   templ.Attributes
}

// Marker is a line in the conversation that nobody said: "Ana entrou",
// "Gerando resposta…", a date between days.
//
// The separator variant is not role="separator" on purpose: a separator's
// children are presentational, so its label would vanish for screen readers.
// The text reads as text; only the rules beside it are hidden.
templ Marker(props MarkerProps) {
	if props.Variant == "separator" {
		<div
			if props.Status {
				role="status"
			}
			class="flex items-center gap-3 py-2 text-xs text-muted"
			{ props.Attrs... }
		>
			<span aria-hidden="true" class="h-px flex-1 bg-border"></span>
			<span class="shrink-0">{ children... }</span>
			<span aria-hidden="true" class="h-px flex-1 bg-border"></span>
		</div>
	} else {
		<div
			if props.Status {
				role="status"
			}
			class={ "flex items-center justify-center gap-2 py-2 text-xs text-muted",
				templ.KV("rounded border border-border px-3", props.Variant == "border") }
			{ props.Attrs... }
		>
			if props.Icon != "" {
				<span aria-hidden="true">{ props.Icon }</span>
			}
			<span>{ children... }</span>
		</div>
	}
}
