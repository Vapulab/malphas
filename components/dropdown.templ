package components

type DropdownProps struct {
	ID      string
	Label   string // the trigger's text
	Entries []MenuEntry
	// Position is fixed by the caller: start|end horizontally, top|bottom
	// vertically, combined as "bottom-start" (default). No viewport
	// measurement — near an edge, the page author picks the side.
	Position string
	Variant  string // button variant for the trigger (default secondary)
	Attrs    templ.Attributes
}

func (p DropdownProps) menuID() string { return p.ID + "-menu" }

func (p DropdownProps) menuPosition() string { return floatingPosition(p.Position) }

// Dropdown is the menu-button pattern: a trigger that opens a list of actions.
//
// It is the non-modal counterpart to Drawer. Arrows move between items and
// Escape closes and returns focus, but Tab leaves and closes — trapping focus
// in a menu would be as wrong as failing to trap it in a dialog.
//
// Unlike Menu, this one does claim role="menu": these are application actions,
// not site navigation.
templ Dropdown(props DropdownProps) {
	<div class="relative inline-block" x-data="dropdownMenu" x-on:keydown="onMenuKeydown($event)" x-on:click.outside="close({ restoreFocus: false })" { props.Attrs... }>
		<button
			type="button"
			x-ref="trigger"
			aria-haspopup="menu"
			aria-expanded="false"
			aria-controls={ props.menuID() }
			x-bind:aria-expanded="open ? 'true' : 'false'"
			x-on:click="toggle()"
			x-on:keydown.arrow-down.prevent="show()"
			class={ "inline-flex items-center gap-2 rounded px-4 py-2 text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/50",
				dropdownTriggerClasses(or(props.Variant, "secondary")) }
		>
			{ props.Label }
			<span aria-hidden="true" class="text-xs transition-transform" x-bind:class="open && 'rotate-180'">&#9662;</span>
		</button>
		<template x-if="open">
			<div
				id={ props.menuID() }
				role="menu"
				aria-label={ props.Label }
				class={ "absolute z-40 min-w-48 rounded border border-border bg-surface py-1 shadow-lg",
					props.menuPosition() }
			>
				for i, e := range props.Entries {
					if e.isDivider() {
						<div role="separator" class="my-1 h-px bg-border"></div>
					} else {
						@dropdownItem(e, i)
					}
				}
			</div>
		</template>
	</div>
}

templ dropdownItem(e MenuEntry, index int) {
	if e.Href != "" {
		<a
			role="menuitem"
			href={ templ.URL(e.Href) }
			data-roving-item={ intJS(index) }
			tabindex={ rovingTabindex(index, 0) }
			x-bind:tabindex={ "tabindex(" + intJS(index) + ")" }
			class={ "block px-4 py-2 text-sm focus:outline-none focus:bg-muted/10", dropdownItemClasses(e) }
		>
			{ e.Label }
		</a>
	} else {
		<button
			type="button"
			role="menuitem"
			data-roving-item={ intJS(index) }
			if e.Disabled {
				data-roving-disabled
				disabled
			}
			tabindex={ rovingTabindex(index, 0) }
			x-bind:tabindex={ "tabindex(" + intJS(index) + ")" }
			if e.OnClick != "" {
				x-on:click={ e.OnClick + "; close()" }
			}
			class={ "block w-full px-4 py-2 text-left text-sm focus:outline-none focus:bg-muted/10", dropdownItemClasses(e) }
		>
			{ e.Label }
		</button>
	}
}
