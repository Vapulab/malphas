package components

import "strconv"

type DrawerProps struct {
	ID    string
	Title string
	Side  string // left | right | bottom (default left)
	Attrs templ.Attributes
}

func (p DrawerProps) titleID() string { return p.ID + "-title" }

// bottom is a sheet rising from the bottom edge, the shadcn "Drawer": full
// width and height capped, so the page above stays visible as context.
func (p DrawerProps) panelClasses() string {
	base := "relative z-10 flex flex-col overflow-y-auto border-border bg-surface p-6 shadow-lg focus:outline-none"
	switch or(p.Side, "left") {
	case "right":
		return base + " h-full w-80 max-w-[85vw] ml-auto border-l"
	case "bottom":
		return base + " mt-auto w-full max-h-[85vh] rounded-t-lg border-t"
	default:
		return base + " h-full w-80 max-w-[85vw] mr-auto border-r"
	}
}

// Drawer is a modal side panel. Open it from anywhere inside an Alpine scope
// with x-on:click="$dispatch('open-drawer', 'ID')".
//
// Modality comes from modalOverlay(): focus trap, scroll lock and inert
// siblings. A side panel that lets Tab wander into the page behind it is worse
// than a modal dialog doing the same, because it looks like the page is still
// usable.
templ Drawer(props DrawerProps) {
	<div
		x-data="drawer"
		x-on:open-drawer.window={ "if ($event.detail === " + strconv.Quote(props.ID) + ") openOverlay()" }
		x-on:keydown.escape.window="onEscape()"
		{ props.Attrs... }
	>
		<template x-if="open">
			<div class="fixed inset-0 z-50 flex">
				<div class="absolute inset-0 bg-black/50" x-on:click="closeOverlay()"></div>
				<div
					x-ref="panel"
					role="dialog"
					aria-modal="true"
					aria-labelledby={ props.titleID() }
					tabindex="-1"
					x-on:keydown.tab="onTab($event)"
					class={ props.panelClasses() }
				>
					<div class="mb-4 flex items-center justify-between gap-4">
						<h2 id={ props.titleID() } class="text-lg font-semibold text-fg">{ props.Title }</h2>
						<button
							type="button"
							aria-label="Fechar"
							class="rounded text-muted hover:text-fg focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/50"
							x-on:click="closeOverlay()"
						>&times;</button>
					</div>
					{ children... }
				</div>
			</div>
		</template>
	</div>
}
