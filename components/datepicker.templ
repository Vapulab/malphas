package components

type DatePickerProps struct {
	ID       string
	Name     string
	Label    string
	Value    string // YYYY-MM-DD, the format <input type="date"> speaks
	Min      string // YYYY-MM-DD
	Max      string // YYYY-MM-DD
	Required bool
	Disabled bool
	Attrs    templ.Attributes // on the input, so Field.ControlAttrs() fits
}

// DatePicker is the native date input, styled — the same call as Select: the
// platform picker (the phone's own wheel or calendar, the desktop's grid) is
// better at touch, keyboard and screen readers than anything we would build,
// and the value always arrives as YYYY-MM-DD whatever the user's locale shows.
//
// For a calendar that stays visible on the page — an agenda, choosing a
// period — use Calendar.
templ DatePicker(props DatePickerProps) {
	<div class="flex flex-col gap-1">
		if props.Label != "" {
			@Label(LabelProps{For: props.ID, Required: props.Required}) {
				{ props.Label }
			}
		}
		<input
			type="date"
			id={ props.ID }
			name={ props.Name }
			value={ props.Value }
			if props.Min != "" {
				min={ props.Min }
			}
			if props.Max != "" {
				max={ props.Max }
			}
			required?={ props.Required }
			disabled?={ props.Disabled }
			class="h-10 w-full rounded border border-border bg-surface px-3 text-sm text-fg [color-scheme:light] focus:outline-none focus:ring-2 focus:ring-primary/50 disabled:cursor-not-allowed disabled:opacity-50 dark:[color-scheme:dark]"
			{ props.Attrs... }
		/>
	</div>
}
