package components

type EmptyProps struct {
	Title       string
	Description string
	Icon        templ.Component // decorative; rendered aria-hidden
	Attrs       templ.Attributes
}

// Empty is the "nothing here yet" state. The title is a <p>, not a heading:
// the level depends on the page around it, which Empty cannot know. Callers
// that need a heading pass their own in place of Title.
templ Empty(props EmptyProps) {
	<div class="flex flex-col items-center justify-center gap-4 rounded border border-dashed border-border px-6 py-10 text-center" { props.Attrs... }>
		if props.Icon != nil {
			<div aria-hidden="true" class="flex size-12 items-center justify-center rounded-full bg-muted/10 text-xl text-muted">
				@props.Icon
			</div>
		}
		<div class="flex flex-col gap-1">
			if props.Title != "" {
				<p class="text-base font-semibold text-fg">{ props.Title }</p>
			}
			if props.Description != "" {
				<p class="max-w-sm text-sm text-muted">{ props.Description }</p>
			}
		</div>
		<div class="flex flex-wrap justify-center gap-2 empty:hidden">
			{ children... }
		</div>
	</div>
}
