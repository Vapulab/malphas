package components

import "strconv"

type ModalProps struct {
	ID    string
	Title string
	Attrs templ.Attributes
}

func (p ModalProps) titleID() string { return p.ID + "-title" }

// Open a modal with x-on:click="$dispatch('open-modal', 'ID')" on any trigger
// that sits inside an Alpine scope — a bare <div x-data> wrapper is enough.
// Alpine ignores directives on elements with no x-data ancestor.
//
// Modality comes from modalOverlay() in malphas.js: focus trap, scroll lock and
// inert siblings. The first version of this component had none of the three,
// so a keyboard user could Tab straight out into the page behind it.
templ Modal(props ModalProps) {
	<div
		x-data="modal"
		x-on:open-modal.window={ "if ($event.detail === " + strconv.Quote(props.ID) + ") openOverlay()" }
		x-on:keydown.escape.window="onEscape()"
		{ props.Attrs... }
	>
		// x-if builds the content on every open, after htmx scanned the page:
		// x-init hands it to htmx, or an hx-post form inside would submit natively.
		<template x-if="open">
			<div class="fixed inset-0 z-50 flex items-center justify-center p-4" x-init="window.htmx && htmx.process($el)">
				<div class="absolute inset-0 bg-black/50" x-on:click="closeOverlay()"></div>
				<div
					x-ref="panel"
					role="dialog"
					aria-modal="true"
					aria-labelledby={ props.titleID() }
					tabindex="-1"
					x-on:keydown.tab="onTab($event)"
					class="relative z-10 max-h-full w-full max-w-md overflow-y-auto [scrollbar-width:thin] rounded border border-border bg-surface p-6 shadow-lg focus:outline-none"
				>
					<div class="mb-4 flex items-center justify-between gap-4">
						<h2 id={ props.titleID() } class="text-lg font-semibold text-fg">{ props.Title }</h2>
						<button
							type="button"
							aria-label="Fechar"
							class="rounded text-muted hover:text-fg focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/50"
							x-on:click="closeOverlay()"
						>&times;</button>
					</div>
					{ children... }
				</div>
			</div>
		</template>
	</div>
}
